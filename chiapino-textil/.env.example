# Copiá este archivo como .env.local (que NO se sube al repo) y completá la clave para probar en local.
# En Cloudflare estas variables van en Settings > Variables and Secrets, no en archivos.
GEMINI_API_KEY=
# Opcional: modelos a probar en orden (si uno llega al límite gratis, pasa al siguiente)
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# Opcional: límite por IP compartido (Upstash Redis, plan gratis)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Opcional: otros dominios que pueden usar el chat, separados por coma
# ALLOWED_ORIGINS=https://www.textilchiapino.com.ar
# Sólo local: respuestas fijas para probar la interfaz sin clave
# CHAT_MOCK=1
